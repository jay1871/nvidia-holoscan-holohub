+#include "htk_jesd.hpp"
+#include "logging_internal.hpp"
+
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+
+namespace hololink {
+
+static constexpr uint32_t HOLOSCAN_USER_BASE_ADDR = 0x10000000;
+static constexpr uint32_t HTK_JESD_LINK_BASE_ADDR = HOLOSCAN_USER_BASE_ADDR + 0x0000D000;
+
+static constexpr uint32_t HTK_JESD_LINK_COM_STS_OFFSET = (0x44);
+static constexpr uint32_t HTK_JESD_LINK_TX_STS_OFFSET = (0x54);
+static constexpr uint32_t HTK_JESD_LINK_RX_STS_OFFSET = (0x64);
+
+
+HTK_JESD_HPS_Config::HTK_JESD_HPS_Config(Hololink& hololink)
+    : hololink_(hololink)
+    , jesd_configured_(false)
+{
+}
+
+void HTK_JESD_HPS_Config::apply(void)
+{
+    // manual jesd config for demo
+    // config only nvidia IP and not jesd
+    configure();
+    run();
+
+    while (!jesd_configured_.load(std::memory_order_relaxed)) {
+        HSB_LOG_INFO("Waiting for JESD configuration to complete...");
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+    }
+    HSB_LOG_INFO("JESD configuration complete");
+}
+
+void HTK_JESD_HPS_Config::host_pause_mapping(uint32_t mask)
+{
+    host_pause_mapping_mask_ = mask;
+}
+
+void HTK_JESD_HPS_Config::power_on()
+{
+  // performed by hps
+}
+
+void HTK_JESD_HPS_Config::setup_clocks()
+{
+  // performed by hps
+}
+
+void HTK_JESD_HPS_Config::configure()
+{
+    HSB_LOG_INFO("JESD::configure");
+
+    // Packetizer Programming
+    hololink_.write_uint32(0x0100000C, 0x10000001);
+    hololink_.write_uint32(0x01000004, 0x00000000);
+    hololink_.write_uint32(0x01000008, 0xFFFFFFFF);
+    hololink_.write_uint32(0x01000004, 0x00000070);
+    hololink_.write_uint32(0x01000008, 0x00000001);
+
+    //Sensor reset off
+    hololink_.write_uint32(0x00000008, 0x0000000F);
+
+    // Map Pause to ethernet interface
+    hololink_.write_uint32(0x0120000C, host_pause_mapping_mask_);
+
+}
+
+void HTK_JESD_HPS_Config::run()
+{
+    HSB_LOG_INFO("JESD::run");
+
+    hololink_.write_uint32(0x01200000, 0x3); // Enable TX
+
+    jesd_configured_.store(true, std::memory_order_release);
+}
+
+bool HTK_JESD_HPS_Config::task_refclk_sw(uint32_t channel, uint32_t refclk, uint32_t hwseq)
+{
+    // performed by hps
+    return true;
+}
+
+bool HTK_JESD_HPS_Config::task_set_pma_attribute(uint32_t channel, uint32_t code, uint32_t data)
+{
+    // performed by hps
+    return true;
+}
+
+void HTK_JESD_HPS_Config::task_pma_analog_reset(uint32_t channel)
+{
+      // performed by hps
+
+}
+
+void HTK_JESD_HPS_Config::configure_nvda_jesd_tx(void)
+{
+      // performed by hps
+}
+
+void HTK_JESD_HPS_Config::configure_nvda_jesd_rx(void)
+{
+      // performed by hps
+}
+
+bool HTK_JESD_HPS_Config::verify_link_status()
+{
+    uint32_t offset;
+    uint32_t status;
+    bool ok = true;
+
+
+    offset = HTK_JESD_LINK_BASE_ADDR + HTK_JESD_LINK_COM_STS_OFFSET;
+    status = hololink_.read_uint32(offset);
+
+    if (status & 0x1) {
+      HSB_LOG_INFO("JESD204 Core PLL lock Status: {:#x}", status & 0x1);
+    }
+    else {
+      ok &= false;
+      HSB_LOG_ERROR("JESD204 Core PLL lock Status: {:#x}", status & 0x1);
+    }
+
+    if (status & 0x10) {
+      HSB_LOG_INFO("JESD204 Sys PLL lock Status: {:#x}", status & 0x10);
+    }
+    else {
+      ok &= false;
+      HSB_LOG_ERROR("JESD204 Sys PLL lock Status: {:#x}", status & 0x10);
+    }
+
+
+    offset = HTK_JESD_LINK_BASE_ADDR + HTK_JESD_LINK_TX_STS_OFFSET;
+    status = hololink_.read_uint32(offset);
+
+    if (status & 0x1) {
+      HSB_LOG_INFO("JESD204 TX DAC Link Status: {:#x}", status & 0x1);
+    }
+    else {
+      ok &= false;
+      HSB_LOG_ERROR("JESD204 TX DAC Link Status: {:#x}", status & 0x1);
+    }
+
+    offset = HTK_JESD_LINK_BASE_ADDR + HTK_JESD_LINK_RX_STS_OFFSET;
+    status = hololink_.read_uint32(offset);
+
+    if (status & 0x1) {
+      HSB_LOG_INFO("JESD204 RX ADC Link Status: {:#x}", status & 0x1);
+    }
+    else {
+      ok &= false;
+      HSB_LOG_ERROR("JESD204 RX ADC Link Status: {:#x}", status & 0x1);
+    }
+
+    if (ok) {
+        HSB_LOG_INFO("JESD link status: OK");
+    }
+
+    return ok;
+}
+
+} // namespace hololink
