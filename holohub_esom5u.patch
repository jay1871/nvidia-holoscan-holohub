++void HTK_JESD_HPS_Config::apply(void)
++{
++    // manual jesd config for demo
++    // config only nvidia IP and not jesd
++    configure();
++    run();
++
++    while (!jesd_configured_.load(std::memory_order_relaxed)) {
++        HSB_LOG_INFO("Waiting for JESD configuration to complete...");
++        std::this_thread::sleep_for(std::chrono::seconds(1));
