diff --git a/applications/hermes2host/cpp/spectral_kernels.cu b/applications/hermes2host/cpp/spectral_kernels.cu
new file mode 100644
index 000000000..59d5b9495
--- /dev/null
+++ b/applications/hermes2host/cpp/spectral_kernels.cu
@@ -0,0 +1,239 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2025-2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "spectral_kernels.cuh"
+#include <cstdint>
+#include <math_constants.h>
+
+// ============================================================================
+// Hanning window generation
+// ============================================================================
+
+__global__ void hanning_window_kernel(float* out, int n) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) {
+    out[i] = 0.5f * (1.0f - cosf(2.0f * CUDART_PI_F * i / (n - 1)));
+  }
+}
+
+void generate_hanning_window(float* out, int n, cudaStream_t stream) {
+  int threads = 256;
+  int blocks = (n + threads - 1) / threads;
+  hanning_window_kernel<<<blocks, threads, 0, stream>>>(out, n);
+}
+
+// ============================================================================
+// Int16 IQ → complex float with window
+// ============================================================================
+
+__global__ void window_int16_to_complex_kernel(const int16_t* in, const float* window,
+                                               cufftComplex* out, int num_samples,
+                                               int iq_swap) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < num_samples) {
+    float w = window[i];
+    float first  = static_cast<float>(in[2 * i]) * w;
+    float second = static_cast<float>(in[2 * i + 1]) * w;
+    // iq_swap=0: I,Q order (conjugate Q to flip spectrum right)
+    // iq_swap=1: Q,I order
+    // iq_swap=2: I,Q with conjugate (negate Q)
+    if (iq_swap == 1) {
+      out[i].x = second;
+      out[i].y = first;
+    } else if (iq_swap == 2) {
+      out[i].x = first;
+      out[i].y = -second;
+    } else {
+      out[i].x = first;
+      out[i].y = second;
+    }
+  }
+}
+
+void apply_window_int16_to_complex(const int16_t* in, const float* window,
+                                   cufftComplex* out, int num_samples,
+                                   int iq_swap, cudaStream_t stream) {
+  int threads = 256;
+  int blocks = (num_samples + threads - 1) / threads;
+  window_int16_to_complex_kernel<<<blocks, threads, 0, stream>>>(in, window, out, num_samples, iq_swap);
+}
+
+// ============================================================================
+// Magnitude in dB with fftshift
+// ============================================================================
+
+__global__ void magnitude_db_fftshift_kernel(const cufftComplex* in, float* out, int n,
+                                             int reverse) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) {
+    int src = reverse ? (n / 2 - i + n) % n : (i + n / 2) % n;
+    float re = in[src].x;
+    float im = in[src].y;
+    float mag_sq = re * re + im * im;
+    if (mag_sq < 1e-40f) mag_sq = 1e-40f;
+    // Normalize to dBFS: reference = (N * INT16_MAX * Hanning_coherent_gain)^2
+    float ref = (float)n * 32768.0f * 0.5f;
+    out[i] = 10.0f * log10f(mag_sq / (ref * ref));
+  }
+}
+
+void magnitude_db_fftshift(const cufftComplex* in, float* out, int n,
+                           int reverse, cudaStream_t stream) {
+  int threads = 256;
+  int blocks = (n + threads - 1) / threads;
+  magnitude_db_fftshift_kernel<<<blocks, threads, 0, stream>>>(in, out, n, reverse);
+}
+
+
+// ============================================================================
+// DC block — replace center bin(s) with neighbor average
+// ============================================================================
+
+__global__ void dc_block_kernel(float* out, int n, int dc_bins) {
+  if (dc_bins <= 0) return;
+
+  int center = n / 2;
+  int half = dc_bins / 2;
+  int lo = center - half;
+  int hi = center + half;
+  if (lo < 0) lo = 0;
+  if (hi >= n) hi = n - 1;
+
+  float left_val = (lo > 0) ? out[lo - 1] : out[hi + 1];
+  float right_val = (hi < n - 1) ? out[hi + 1] : out[lo - 1];
+  float fill = (left_val + right_val) * 0.5f;
+
+  for (int i = lo; i <= hi; i++) {
+    out[i] = fill;
+  }
+}
+
+void dc_block_magnitude(float* out, int n, int dc_bins, cudaStream_t stream) {
+  dc_block_kernel<<<1, 1, 0, stream>>>(out, n, dc_bins);
+}
+
+// ============================================================================
+// Normalize to [0,1] coordinate pairs for Holoviz line plot
+// ============================================================================
+
+__global__ void normalize_to_coords_kernel(const float* in, float* out,
+                                           int bin_start, int num_bins,
+                                           float db_min, float db_max,
+                                           int flip_x) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < num_bins) {
+    float x = static_cast<float>(i) / static_cast<float>(num_bins - 1);
+    if (flip_x) x = 1.0f - x;
+    float y = (in[bin_start + i] - db_min) / (db_max - db_min);
+    y = fminf(fmaxf(y, 0.0f), 1.0f);
+    y = 1.0f - y;
+    out[2 * i] = x;
+    out[2 * i + 1] = y;
+  }
+}
+
+void normalize_to_coords(const float* in, float* out, int n,
+                         float db_min, float db_max,
+                         int bin_start, int bin_end,
+                         int flip_x, cudaStream_t stream) {
+  int num_bins = bin_end - bin_start;
+  int threads = 256;
+  int blocks = (num_bins + threads - 1) / threads;
+  normalize_to_coords_kernel<<<blocks, threads, 0, stream>>>(in, out, bin_start, num_bins, db_min, db_max, flip_x);
+}
+
+// ============================================================================
+// Accumulate linear power (for FFT averaging)
+// ============================================================================
+
+__global__ void accumulate_power_fftshift_kernel(const cufftComplex* in, float* accum, int n,
+                                                int reverse) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) {
+    int src = reverse ? (n / 2 - i + n) % n : (i + n / 2) % n;
+    float re = in[src].x;
+    float im = in[src].y;
+    accum[i] += re * re + im * im;
+  }
+}
+
+void accumulate_power_fftshift(const cufftComplex* in, float* accum, int n,
+                               int reverse, cudaStream_t stream) {
+  int threads = 256;
+  int blocks = (n + threads - 1) / threads;
+  accumulate_power_fftshift_kernel<<<blocks, threads, 0, stream>>>(in, accum, n, reverse);
+}
+
+// ============================================================================
+// Convert accumulated power to dB (finalize averaging)
+// ============================================================================
+
+__global__ void power_to_db_kernel(const float* accum, float* out, int n, int num_averages) {
+  int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i < n) {
+    float avg_power = accum[i] / static_cast<float>(num_averages);
+    if (avg_power < 1e-40f) avg_power = 1e-40f;
+    // Normalize to dBFS: reference = (N * INT16_MAX * Hanning_coherent_gain)^2
+    float ref = (float)n * 32768.0f * 0.5f;
+    out[i] = 10.0f * log10f(avg_power / (ref * ref));
+  }
+}
+
+
+void power_to_db(const float* accum, float* out, int n, int num_averages,
+                 cudaStream_t stream) {
+  int threads = 256;
+  int blocks = (n + threads - 1) / threads;
+  power_to_db_kernel<<<blocks, threads, 0, stream>>>(accum, out, n, num_averages);
+}
+
+// ============================================================================
+// Gather IQ from strided batch into contiguous accumulation buffer
+// ============================================================================
+
+__global__ void gather_iq_kernel(const uint8_t* src, int16_t* dst,
+                                 int num_pkts, int samples_per_pkt,
+                                 int stride_bytes, int dst_sample_offset) {
+  int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  int total_samples = num_pkts * samples_per_pkt;
+  if (idx >= total_samples) return;
+
+  int pkt = idx / samples_per_pkt;
+  int sample_in_pkt = idx % samples_per_pkt;
+
+  // Source: pkt * stride_bytes + sample_in_pkt * 4 bytes (2x int16)
+  const int16_t* pkt_start = reinterpret_cast<const int16_t*>(src + pkt * stride_bytes);
+  int16_t i_val = pkt_start[sample_in_pkt * 2];
+  int16_t q_val = pkt_start[sample_in_pkt * 2 + 1];
+
+  // Destination: contiguous [I,Q,I,Q,...] starting at dst_sample_offset
+  int dst_idx = (dst_sample_offset + idx) * 2;
+  dst[dst_idx] = i_val;
+  dst[dst_idx + 1] = q_val;
+}
+
+void gather_iq_from_batch(const void* src, int16_t* dst,
+                          int num_pkts, int samples_per_pkt,
+                          int stride_bytes, int dst_sample_offset,
+                          cudaStream_t stream) {
+  int total_samples = num_pkts * samples_per_pkt;
+  int threads = 256;
+  int blocks = (total_samples + threads - 1) / threads;
+  gather_iq_kernel<<<blocks, threads, 0, stream>>>(
+      static_cast<const uint8_t*>(src), dst,
+      num_pkts, samples_per_pkt, stride_bytes, dst_sample_offset);
+}
