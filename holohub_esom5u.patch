++bool HTK_JESD_HPS_Config::verify_link_status()
++{
++    uint32_t offset;
++    uint32_t status;
++    bool ok = true;
++
++
++    offset = HTK_JESD_LINK_BASE_ADDR + HTK_JESD_LINK_COM_STS_OFFSET;
++    status = hololink_.read_uint32(offset);
++
++    if (status & 0x1) {
++      HSB_LOG_INFO("JESD204 Core PLL lock Status: {:#x}", status & 0x1);
++    }
++    else {
++      ok &= false;
++      HSB_LOG_ERROR("JESD204 Core PLL lock Status: {:#x}", status & 0x1);
++    }
++
++    if (status & 0x10) {
++      HSB_LOG_INFO("JESD204 Sys PLL lock Status: {:#x}", status & 0x10);
++    }
++    else {
++      ok &= false;
++      HSB_LOG_ERROR("JESD204 Sys PLL lock Status: {:#x}", status & 0x10);
++    }
++
++
++    offset = HTK_JESD_LINK_BASE_ADDR + HTK_JESD_LINK_TX_STS_OFFSET;
++    status = hololink_.read_uint32(offset);
++
++    if (status & 0x1) {
++      HSB_LOG_INFO("JESD204 TX DAC Link Status: {:#x}", status & 0x1);
++    }
++    else {
++      ok &= false;
++      HSB_LOG_ERROR("JESD204 TX DAC Link Status: {:#x}", status & 0x1);
++    }
++
++    offset = HTK_JESD_LINK_BASE_ADDR + HTK_JESD_LINK_RX_STS_OFFSET;
++    status = hololink_.read_uint32(offset);
++
++    if (status & 0x1) {
++      HSB_LOG_INFO("JESD204 RX ADC Link Status: {:#x}", status & 0x1);
++    }
++    else {
++      ok &= false;
++      HSB_LOG_ERROR("JESD204 RX ADC Link Status: {:#x}", status & 0x1);
++    }
++
++    if (ok) {
++        HSB_LOG_INFO("JESD link status: OK");
++    }
++
++    return ok;
++}
++
++} // namespace hololink
